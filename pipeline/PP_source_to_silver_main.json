{
	"name": "PP_source_to_silver_main",
	"properties": {
		"activities": [
			{
				"name": "Read_source_table_list",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    table_id\nFROM ctrl.table_config\nWHERE\n    1=1\n    AND is_active = 'True'\n    AND source_system = '@{pipeline().parameters.source_system}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Data_set_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"source_system": {
				"type": "string",
				"defaultValue": "neon_postgres"
			}
		},
		"annotations": []
	}
}